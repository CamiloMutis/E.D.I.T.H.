# Copia este archivo como .env y completa los valores.
# El archivo .env nunca se sube al repositorio.

# --- Telegram (obligatorio para el bot) ---
# Se obtiene con @BotFather usando /newbot
TELEGRAM_BOT_TOKEN=
# Tu id de Telegram (pídeselo a @userinfobot). Te da los comandos /admin,
# /anuncio y /reentrenar, y te llegan los avisos de errores del bot.
TELEGRAM_ADMIN_ID=

# --- Servidor (modo de varios estudiantes) ---
# Clave para cifrar los accesos a Moodle de los estudiantes. Genérala con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si se deja vacía, se crea una en data/clave_maestra. Si se pierde, cada
# estudiante debe volver a conectar su Moodle.
EDITH_CLAVE_MAESTRA=
# Quién puede usar el bot. Cualquiera puede encontrarlo buscando su @ en
# Telegram, y cada mensaje gasta TUS llaves de LLM, por eso es privado por defecto:
#   privado    → solo tú (TELEGRAM_ADMIN_ID) y los ids de EDITH_USUARIOS_PERMITIDOS;
#                a los demás les responde que es privado, sin guardar nada.
#   invitacion → quien escriba el código de EDITH_CODIGO_INVITACION en /start.
#   publico    → cualquier estudiante.
EDITH_ACCESO=privado
# Ids de Telegram de otras personas autorizadas, separados por comas (modo privado).
EDITH_USUARIOS_PERMITIDOS=
# Código de invitación (modo invitacion).
EDITH_CODIGO_INVITACION=
# Opcional: carpeta para las cuentas y los datos de cada estudiante (Docker: /datos).
EDITH_DATOS=
# Opcional: modo webhook. Dirección pública https del servidor (p. ej. en Render);
# el bot escucha en el puerto PORT y responde "ok" en /salud.
EDITH_WEBHOOK_URL=

# --- LLM: banco de proveedores ---
# Tú decides el orden: se usa el primero y, cuando se queda sin cuota, falla o
# no responde, la misma conversación sigue con el siguiente. Ejemplo:
#   LLM_PROVIDERS=groq,openai,anthropic   → Groq; si se acaba, GPT; si se acaba, Claude
# Proveedores incluidos: groq, openai, anthropic, gemini. Cualquier otra API
# compatible con OpenAI también sirve (ver «Otros proveedores» abajo).
# Si lo dejas vacío, el banco se arma con las llaves que tengas aquí, en el
# orden groq, openai, anthropic, gemini (LLM_PROVIDER, si lo pones, va primero).
LLM_PROVIDERS=
LLM_PROVIDER=
#
# Varias llaves de un mismo proveedor (por ejemplo, dos cuentas gratuitas de
# Groq) se separan con comas y se usan una tras otra: GROQ_API_KEY=gsk_1,gsk_2

# Groq: llave gratuita en https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Opcional: Claude (https://platform.claude.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Opcional: GPT (https://platform.openai.com). Indica el modelo a usar.
OPENAI_API_KEY=
OPENAI_MODEL=

# Opcional: Gemini, llave gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Otros proveedores compatibles con OpenAI: ponles un nombre, agrégalo a
# LLM_PROVIDERS y define <NOMBRE>_BASE_URL, <NOMBRE>_MODEL y <NOMBRE>_API_KEY.
# Ejemplos:
#   LLM_PROVIDERS=groq,openrouter
#   OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#   OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
#   OPENROUTER_API_KEY=
#
#   Ollama en tu computador (no pide llave):
#   OLLAMA_BASE_URL=http://localhost:11434/v1
#   OLLAMA_MODEL=llama3.2

# --- Google Calendar (opcional) ---
# Si credentials.json existe en la raíz se usa Google Calendar;
# si no, el agente trabaja con un calendario local en SQLite.
GOOGLE_CREDENTIALS=credentials.json
GOOGLE_TOKEN=token.json
GOOGLE_CALENDAR_ID=primary

# --- Moodle (opcional) ---
# Plataforma académica de donde se leen los próximos eventos del calendario.
# Cada estudiante conecta su propio Moodle desde el chat (/start o /conectar_moodle).
MOODLE_URL=https://pregradov.usc.edu.co
# Solo para el modo consola y para pasar tu instalación anterior a tu cuenta.
MOODLE_USUARIO=
MOODLE_CLAVE=
